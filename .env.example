# Copie para .env e ajuste para o seu ambiente. Nunca commite o .env real.

# Banco de dados. Padrão: SQLite num arquivo local — não exige instalar
# nada além do Python (bom para uso pessoal, num só computador).
DATABASE_URL=sqlite:///./jarvis.db
# Para produção real, multiusuário, troque para Postgres, por exemplo:
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# Chave usada para assinar o cookie de sessão (JWT). Gere uma própria em produção:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao

# Horas de validade da sessão de login.
SESSION_TTL_HORAS=12

# Diretório onde os arquivos exportados do Orbit são guardados após importação (auditoria).
DIRETORIO_IMPORTACOES=./data/importacoes_orbit

# Diretório com os templates de mensagem do panorama mensal (um .txt por tipo_estrutura).
DIRETORIO_TEMPLATES_PANORAMA=./templates_mensagens
